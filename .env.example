# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Smart Contract Escrow
# After deploying KwachaEscrow.sol, set these addresses
VITE_ESCROW_CONTRACT_BSC=0x...your_deployed_bsc_contract_address
VITE_ESCROW_CONTRACT_TRC20=T...your_deployed_tron_contract_address

# Optional: custom BSC RPC
VITE_BSC_RPC=https://bsc-dataseed.binance.org
